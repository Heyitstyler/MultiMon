diff --git a/src/sound_radio_sys.c b/src/sound_radio_sys.c
index 17d5f65..f27412b 100644
--- a/src/sound_radio_sys.c
+++ b/src/sound_radio_sys.c
@@ -45,3 +45,22 @@ void SndRadio_PausePlayer(BOOL flag) {
 int SndRadio_CountPlayingSeq(void) {
     return NNS_SndPlayerCountPlayingSeqByPlayerNo(PLAYER_RADIO);
 }
+
+#ifdef SDK_PC
+/* hg_pc (pc/src/pc_snd.c): the ARM7 sequence players playing music right now (the field music, the
+ * BGM, jingles and the radio), one bit each, so music can keep real time while sound effects follow
+ * the game speed. */
+u32 PC_SndMusicPlayers(void) {
+    NNSSndSeqPlayer *players[] = {
+        GF_GetSoundHandle(SND_HANDLE_FIELD)->player, GF_GetSoundHandle(SND_HANDLE_BGM)->player,
+        GF_GetSoundHandle(SND_HANDLE_ME)->player, sSndHandle.player,
+    };
+    u32 mask = 0;
+    for (int i = 0; i < (int)NELEMS(players); i++) {
+        if (players[i] != NULL) {
+            mask |= 1u << players[i]->playerNo;
+        }
+    }
+    return mask;
+}
+#endif
